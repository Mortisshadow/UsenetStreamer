





## Only set the ADDON_BASE_URL and ADDON_SHARED_SECRET and use Admin Panel to configure the rest.



# Indexer manager configuration (supported: prowlarr, nzbhydra)
INDEXER_MANAGER=prowlarr
INDEXER_MANAGER_URL=http://your-indexer-host:port
INDEXER_MANAGER_API_KEY=your-indexer-api-key
INDEXER_MANAGER_STRICT_ID_MATCH=false  # Set to 'true' to disable text-based fallback searches (only use IMDb/TVDB/TMDB IDs)
INDEXER_MANAGER_INDEXERS=-1  # Prowlarr: use -1 for all Usenet indexers; NZBHydra: comma-separated indexer names
#NZB_SEASON_PACK_MODE=background  # NZBDav only: background (recommended), wait, or off
#NZB_SEASON_PACK_CACHE_TTL_MINUTES=720  # Positive staffelweiter Pack-Snapshot (default 12h)
#NZB_SEASON_PACK_PARTIAL_TTL_MINUTES=60  # Useful results from an incomplete source search retry sooner
#NZB_SEASON_PACK_NEGATIVE_TTL_MINUTES=30  # Cache successful searches with no packs briefly
#NZB_SEASON_PACK_MAX_CONCURRENT_SEARCHES=1  # Global background pack-job ceiling; one Prowlarr call may fan out to many indexers
#NZB_SEASON_PACK_MAX_QUEUED_SEARCHES=50  # Reject excess background work instead of growing memory without bounds
#NZB_SEASON_PACK_JOB_TIMEOUT_MS=45000  # Logical watchdog for a whole season-pack job
#NZB_SEASON_PACK_RESCUE_WAIT_MS=12000  # With zero episode results, wait this long for a running pack job
#NZB_INCLUDE_SEASON_PACKS=true  # Legacy fallback only; false maps to mode=off when NZB_SEASON_PACK_MODE is unset
#INDEXER_MANAGER_CACHE_MINUTES=10  # Optional override for NZBHydra cache duration (minutes)

# Addon metadata 
ADDON_BASE_URL=https://your-addon-domain  # Need to be publicly accessible and secure (HTTPS)
ADDON_SHARED_SECRET=super-secret-token  # Required if you want to lock the addon; manifest/stream endpoints live under /<token>/...
#RATE_LIMIT_MAX=180  # Admin-panel requests allowed per minute per IP (default 180). Raise it if the admin panel sits behind a reverse proxy that presents one shared source IP. Stream endpoints are not rate-limited.


# Result sorting defaults
#NZB_SORT_MODE=quality_then_size  # Options: quality_then_size, language_quality_size
#NZB_PREFERRED_LANGUAGE=English  # Only used when the sorting mode prioritizes language
#NZB_MAX_RESULT_SIZE_GB=30  # Defaults to 30 GB; set to 0 for no cap
#NZB_DEDUP_ENABLED=true      # Hide duplicate releases (title + indexer + size)
#NZB_HIDE_BLOCKED_RESULTS=false  # When enabled, removes NZBs flagged as blocked by health checks
#NZB_ALLOWED_RESOLUTIONS=4320p,2160p,1440p,1080p,720p,576p,540p,480p,360p,240p,unknown
#NZB_RESOLUTION_LIMIT_PER_QUALITY=4      # Optional cap applied to every enabled resolution


# NZBDav configuration
NZBDAV_URL=http://localhost:3000
NZBDAV_API_KEY=your-nzbdav-api-key
NZBDAV_WEBDAV_URL=http://localhost:3000
NZBDAV_WEBDAV_USER=webdav-username
NZBDAV_WEBDAV_PASS=webdav-password
#NZBDAV_HISTORY_FETCH_LIMIT=400  # How many completed history entries to scan for instant playback (max 500)
#NZBDAV_CACHE_TTL_MINUTES=1440  # How long to cache mounted NZBs in memory (0 = never expire)
#NZBDAV_CATEGORY=Stremio  # Optional base name to suffix (_TV/_MOVIE/_DEFAULT)

# Easynews integration (optional)
#EASYNEWS_ENABLED=false
#EASYNEWS_USERNAME=your-easynews-username
#EASYNEWS_PASSWORD=your-easynews-password

# NZB triage / health checks
#NZB_TRIAGE_ENABLED=false  # Enable NNTP-backed health checks for NZB candidates
#NZB_STREAM_RESPONSE_BUDGET_MS=24000  # Total Stremio request deadline; blocking health only receives the remaining time
#NZB_STREAM_RESPONSE_RESERVE_MS=1000  # Reserve for stream formatting and sending the response
#NZB_TRIAGE_RACING_LADDER=true  # Hedge ranked candidates and release blocking mode on the first exact verified result
#NZB_TRIAGE_RACING_HEDGE_MS=650  # Delay between starting successive ranked health candidates
#NZB_TRIAGE_DOWNLOAD_CONCURRENCY=4  # Concurrent NZB payload downloads during health checks
#NZB_TRIAGE_MAX_PARALLEL_NZBS=4  # Concurrent NNTP/archive inspections
#NZB_TRIAGE_MAX_CONNECTIONS=6  # Shared NNTP connection ceiling
#NZB_TRIAGE_PAYLOAD_CACHE_MAX_MB=32  # Byte ceiling for short-lived retry payloads; 0 disables the RAM payload cache
#NZB_HEALTH_EVIDENCE_TTL_MINUTES=30  # Reuse an exact positive content/provider/episode health result; 0 disables
#NZB_HEALTH_EVIDENCE_MAX_ENTRIES=5000  # Bounded in-memory LRU size for exact positive health evidence
#NZB_MEMORY_LOGGING=false  # Log rss/heap/external/arrayBuffer usage at key request stages

# Optional Ultimate-compatible ranked Regex + SEL point system. Prefer editing
# this JSON in Admin -> Sort & Filter -> Advanced. Ranked score sorts first;
# the normal configured priority remains the tie-breaker.
#NZB_RANKED_RULES={"rankedStreamExpressions":[{"name":"German","expression":"language(streams, 'German', 'de', 'ger')","score":300}]}
#NZB_TRIAGE_NNTP_HOST=news.provider.net
#NZB_TRIAGE_NNTP_PORT=563
#NZB_TRIAGE_NNTP_TLS=true
#NZB_TRIAGE_NNTP_USER=username
#NZB_TRIAGE_NNTP_PASS=password
